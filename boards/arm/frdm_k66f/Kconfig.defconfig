if BOARD_FRDM_K66F

config BOARD
	default "frdm_k66f"

config OSC_XTAL0_FREQ
	default 12000000

config MCG_PRDIV0
	default 0

config MCG_VDIV0
	default 0xe

config MCG_FCRDIV
	default 1

#config SPI_0
#    default y
#    depends on SPI

if NETWORKING

config NET_L2_ETHERNET
	default y if !MODEM

#config ETH_MCUX_0
#	default y if NET_L2_ETHERNET

endif # NETWORKING

endif # BOARD_FRDM_K66F
